{
  "name": "onecx-ai-provider-ui",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "apigen": "openapi-generator-cli generate -i src/assets/swagger/onecx-ai-provider-bff.yaml -c apigen.yaml -o src/app/shared/generated -g typescript-angular --type-mappings AnyType=object",
    "start": "nx serve --host 0.0.0.0 --disable-host-check",
    "build": "nx build",
    "format": "nx format:write --uncommitted",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "test": "nx test",
    "test:ci": "nx test --watch=false --browsers=ChromeHeadless --code-coverage",
    "prepare": "husky || true",
    "sonar": "npx sonarqube-scanner -Dproject.settings=sonar-local-project.properties",
    "postbuild": "mv \"$(find dist/onecx-ai-provider-ui -maxdepth 1 -type f -name 'styles.*.css' | head -n 1)\" dist/onecx-ai-provider-ui/styles.css"
  },
  "private": true,
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "dependencies": {
    "@angular-architects/module-federation": "^19.0.3",
